# Диаграмма прецедентов (Use Case Diagram)

```mermaid
graph LR
    %% Стилизация
    classDef actor fill:#f9f,stroke:#333,stroke-width:2px;
    classDef system fill:#e1f5fe,stroke:#01579b,stroke-width:2px;
    classDef usecase fill:#fff,stroke:#333,stroke-width:1px,rx:10,ry:10;

    %% Актёры
    Guest["Гость"]:::actor
    User["Пользователь"]:::actor
    Participant["Участник пакта"]:::actor
    Support["Техподдержка"]:::actor
    System[" Система"]:::actor

    User --- Participant

    subgraph Система ["🖥️ Система CoGoal"]
        direction TB
        
        subgraph Auth ["Авторизация и профиль"]
            UC01("US-01: Регистрация"):::usecase
            UC02("US-02: Вход"):::usecase
            UC03("US-03: Профиль"):::usecase
            UC04("US-04: Восстановление пароля"):::usecase
        end

        subgraph Goals ["Цели"]
            UC05("US-05: Создание цели"):::usecase
            UC06("US-06: Редактирование цели"):::usecase
            UC07("US-07: Удаление цели"):::usecase
            UC08("US-08: Категории целей"):::usecase
        end

        subgraph Pacts ["Пакты"]
            UC09("US-09: Лента целей"):::usecase
            UC10("US-10: Отклик на цель"):::usecase
            UC11("US-11: Создание пакта"):::usecase
            UC12("US-12: Принятие/отклонение"):::usecase
            UC13("US-13: Просмотр пакта"):::usecase
            UC14("US-14: Расторжение пакта"):::usecase
            UC15("US-15: Автозавершение пакта"):::usecase
            UC16("US-16: Проверка доказательства"):::usecase
            UC17("US-17: Групповой пакт"):::usecase
            UC18("US-18: Проверка в группе"):::usecase
            UC19("US-19: Повторная отправка"):::usecase
            UC20("US-20: Автопринятие доказательства"):::usecase
        end

        subgraph Comm ["Коммуникация"]
            UC21("US-21: Чат пакта"):::usecase
            UC22("US-22: Уведомления"):::usecase
        end

        subgraph SupportSys ["Техподдержка"]
            UC23("US-23: Обращение в поддержку"):::usecase
            UC24("US-24: Возврат средств"):::usecase
        end
    end

    %% Связи актёров с функциями
    Guest --> UC01
    Guest --> UC02
    Guest --> UC04

    User --> UC03
    User --> UC05
    User --> UC06
    User --> UC07
    User --> UC08
    User --> UC09
    User --> UC10
    User --> UC11
    User --> UC12
    User --> UC13
    User --> UC17
    User --> UC22

    Participant --> UC14
    Participant --> UC16
    Participant --> UC18
    Participant --> UC19
    Participant --> UC21
    Participant --> UC23

    System --> UC15
    System --> UC20

    Support --> UC23
    Support --> UC24

    %% Include связи
    UC10 -.->|include| UC22
    UC11 -.->|include| UC22
    UC12 -.->|include| UC22
    UC15 -.->|include| UC22
    UC16 -.->|include| UC22
    UC20 -.->|include| UC22
    UC23 -.->|include| UC22
    UC24 -.->|include| UC22
